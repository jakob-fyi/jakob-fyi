{
    "name": "jakob-fyi",
    "version": "1.3.0",
    "description": "Personal Website of Jakob Vesely",
    "scripts": {
        "parcel": "npx parcel",
        "generate": "node scripts/build-html.mjs",
        "start": "npm run generate && (node scripts/build-html.mjs --watch & parcel src/index.html)",
        "clean": "rm -rf .parcel-cache dist",
        "lint": "prettier . --write",
        "preci:build": "npm run generate",
        "ci:build": "parcel build src/index.html --log-level error --no-cache --no-source-maps --dist-dir ./dist",
        "pretest": "npm run generate",
        "test": "vitest run",
        "pretest:watch": "npm run generate",
        "test:watch": "vitest"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JakobVesely/jakob-fyi.git"
    },
    "keywords": [
        "website"
    ],
    "author": "Jakob Vesely",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/JakobVesely/jakob-fyi/issues"
    },
    "homepage": "https://github.com/JakobVesely/jakob-fyi#readme",
    "devDependencies": {
        "@parcel/transformer-inline-string": "^2.16.4",
        "@parcel/transformer-sass": "^2.16.4",
        "happy-dom": "^21.0.4",
        "parcel": "^2.16.4",
        "prettier": "^3.9.7",
        "vitest": "^5.1.1"
    },
    "dependencies": {
        "lit": "^3.3.3",
        "typed.js": "^3.0.0"
    },
    "prettier": {
        "trailingComma": "none"
    }
}
